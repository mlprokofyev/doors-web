---
interface Props {
  number: number;
  status: 'active' | 'inactive';
  title?: string;
}

const { number, status, title } = Astro.props;
const isActive = status === 'active';
const href = isActive ? `/doors/${number}/` : undefined;
const label = isActive
  ? `Door ${number}: ${title ?? 'Enter'}`
  : `Door ${number}: Locked`;
---

{isActive ? (
  <a
    href={href}
    class="door door--active"
    aria-label={label}
    data-door={number}
  >
    <div class="door__ornate-frame">
      <div class="door__crown">
        <div class="door__crown-sun"></div>
      </div>
      <div class="door__body">
        <div class="door__pillar door__pillar--left">
          <div class="door__pillar-cap"></div>
          <div class="door__pillar-motif"></div>
          <div class="door__pillar-motif"></div>
          <div class="door__pillar-motif"></div>
          <div class="door__pillar-motif"></div>
          <div class="door__pillar-foot"></div>
        </div>
        <div class="door__inner">
          <div class="door__panel door__panel--active">
            <div class="door__half door__half--left">
              <div class="door__cell door__cell--top"></div>
              <div class="door__cell"></div>
              <div class="door__cell door__cell--accent"></div>
              <div class="door__cell"></div>
              <div class="door__cell door__cell--accent"></div>
              <div class="door__cell"></div>
              <div class="door__cell door__cell--bottom"></div>
            </div>
            <div class="door__half door__half--right">
              <div class="door__cell door__cell--top"></div>
              <div class="door__cell"></div>
              <div class="door__cell door__cell--accent"></div>
              <div class="door__cell"></div>
              <div class="door__cell door__cell--accent"></div>
              <div class="door__cell"></div>
              <div class="door__cell door__cell--bottom"></div>
            </div>
            <span class="door__number door__number--active">{number}</span>
            <div class="door__handle">
              <div class="door__handle-ring"></div>
            </div>
          </div>
        </div>
        <div class="door__pillar door__pillar--right">
          <div class="door__pillar-cap"></div>
          <div class="door__pillar-motif"></div>
          <div class="door__pillar-motif"></div>
          <div class="door__pillar-motif"></div>
          <div class="door__pillar-motif"></div>
          <div class="door__pillar-foot"></div>
        </div>
      </div>
      <div class="door__base"></div>
    </div>
  </a>
) : (
  <div
    class="door door--inactive"
    aria-label={label}
    aria-disabled="true"
    tabindex={-1}
  >
    <div class="door__sprite">
      <div class="door__panel door__panel--inactive">
        <div class="door__knob door__knob--inactive"></div>
      </div>
    </div>
    <span class="door__number">{number}</span>
  </div>
)}

<style>
  /* Kill any inherited borders/outlines on every element inside the tile */
  .door,
  .door * {
    border: 0 none;
    outline: 0 none;
  }

  /* ===== Shared tile ===== */
  .door {
    position: relative;
    aspect-ratio: 3 / 4;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    cursor: default;
    background: #0a0a0a;
    padding: 0;
    margin: 0;
    -webkit-appearance: none;
    appearance: none;
    text-decoration: none;
  }

  /* ===== Active door — Slavic carved wood ===== */
  .door--active {
    cursor: pointer;
  }

  .door--active:hover {
    transform: scale(1.03);
    z-index: 1;
  }

  .door--active:hover .door__panel--active {
    filter: brightness(1.12);
  }

  .door--active:hover .door__ornate-frame {
    box-shadow: none;
  }

  /* Outer ornate frame */
  .door__ornate-frame {
    width: 76%;
    height: 90%;
    position: relative;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.3s;
  }

  /* ---- Crown molding with sun motif ---- */
  .door__crown {
    width: 100%;
    height: 7%;
    background: linear-gradient(180deg, #222828 0%, #1c2222 30%, #181e1e 60%, #141a1a 100%);
    border-radius: 2px 2px 0 0;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      inset 0 -1px 0 rgba(0, 0, 0, 0.5);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Carved dentil row */
  .door__crown::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 3%;
    right: 3%;
    height: 35%;
    background: repeating-linear-gradient(
      90deg,
      #222828 0px, #222828 2px,
      #141a1a 2px, #141a1a 4px
    );
    image-rendering: pixelated;
  }

  /* Top carved rope/braid pattern */
  .door__crown::after {
    content: '';
    position: absolute;
    top: 0;
    left: 3%;
    right: 3%;
    height: 30%;
    background: repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.05) 0px, rgba(255, 255, 255, 0.05) 3px,
      transparent 3px, transparent 4px,
      rgba(255, 255, 255, 0.03) 4px, rgba(255, 255, 255, 0.03) 5px,
      transparent 5px, transparent 8px
    );
    image-rendering: pixelated;
  }

  /* Solar/sun symbol in crown center */
  .door__crown-sun {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: radial-gradient(circle, #303838 0%, #222828 60%, #181e1e 100%);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08),
      0 0 4px rgba(0, 0, 0, 0.4);
    z-index: 1;
    position: relative;
  }

  /* Sun rays */
  .door__crown-sun::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1px dashed rgba(255, 255, 255, 0.08);
  }

  /* ---- Main body: pillars + door ---- */
  .door__body {
    flex: 1;
    display: flex;
    min-height: 0;
  }

  /* Ornate side pillars — carved wood */
  .door__pillar {
    width: 12%;
    background: linear-gradient(180deg, #1c2222 0%, #181e1e 40%, #141a1a 70%, #111616 100%);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2px 0;
    gap: 1px;
  }

  /* Pillar column cap */
  .door__pillar-cap {
    width: 80%;
    height: 4%;
    min-height: 4px;
    background: linear-gradient(180deg, #222828, #181e1e);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 1px 0 rgba(0, 0, 0, 0.4);
  }

  /* Repeating diamond/rhombus motif blocks */
  .door__pillar-motif {
    flex: 1;
    width: 70%;
    position: relative;
    background: linear-gradient(180deg, #181e1e, #1c2222 50%, #181e1e);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.03);
  }

  /* Diamond shape inside each motif */
  .door__pillar-motif::before {
    content: '';
    position: absolute;
    top: 15%;
    left: 15%;
    right: 15%;
    bottom: 15%;
    background: rgba(255, 255, 255, 0.03);
    transform: rotate(45deg);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.05),
      0 0 2px rgba(0, 0, 0, 0.3);
  }

  /* Dot at diamond center */
  .door__pillar-motif::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2px;
    height: 2px;
    transform: translate(-50%, -50%);
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
  }

  /* Pillar foot */
  .door__pillar-foot {
    width: 80%;
    height: 4%;
    min-height: 4px;
    background: linear-gradient(180deg, #181e1e, #111616);
    box-shadow:
      inset 0 -1px 0 rgba(0, 0, 0, 0.4),
      0 -1px 0 rgba(255, 255, 255, 0.03);
  }

  .door__pillar--left {
    box-shadow: inset -1px 0 0 rgba(0, 0, 0, 0.4), inset 1px 0 0 rgba(255, 255, 255, 0.03);
  }

  .door__pillar--right {
    box-shadow: inset 1px 0 0 rgba(0, 0, 0, 0.4), inset -1px 0 0 rgba(255, 255, 255, 0.03);
  }

  /* ---- Inner door area ---- */
  .door__inner {
    flex: 1;
    min-width: 0;
    background: #111616;
    padding: 3px 2px;
  }

  /* Door panel */
  .door__panel--active {
    width: 100%;
    height: 100%;
    display: flex;
    background: linear-gradient(175deg, #55363e 0%, #4a2e34 30%, #40252c 60%, #352025 100%);
    transition: filter 0.2s;
    position: relative;
  }

  /* Each door half */
  .door__half {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 2px;
  }

  .door__half--left {
    border-right: 1px solid rgba(0, 0, 0, 0.3);
  }

  .door__half--right {
    border-left: 1px solid rgba(120, 70, 80, 0.1);
  }

  /* Recessed panel cell — warm wood */
  .door__cell {
    flex: 1;
    background: linear-gradient(170deg, #503a42 0%, #422e36 50%, #3a2830 100%);
    box-shadow:
      inset 1px 1px 0 rgba(140, 80, 95, 0.2),
      inset -1px -1px 0 rgba(0, 0, 0, 0.35),
      inset 2px 2px 3px rgba(0, 0, 0, 0.15),
      inset -2px -2px 3px rgba(0, 0, 0, 0.1);
    position: relative;
  }

  /* Accent cells — with carved rosette/circle motif */
  .door__cell--accent::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 50%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 1px solid rgba(160, 90, 110, 0.18);
    background: radial-gradient(circle, rgba(150, 80, 100, 0.08) 0%, transparent 70%);
    box-shadow: inset 0 0 3px rgba(0, 0, 0, 0.2);
  }

  /* Top cells — subtle arch carved line */
  .door__cell--top {
    border-radius: 1px 1px 0 0;
  }

  .door__cell--top::after {
    content: '';
    position: absolute;
    top: 10%;
    left: 15%;
    right: 15%;
    height: 40%;
    border-radius: 50% 50% 0 0;
    border-top: 1px solid rgba(160, 90, 110, 0.15);
    border-left: 1px solid rgba(160, 90, 110, 0.1);
    border-right: 1px solid rgba(160, 90, 110, 0.1);
  }

  /* Bottom cells — horizontal carved line */
  .door__cell--bottom::after {
    content: '';
    position: absolute;
    bottom: 25%;
    left: 20%;
    right: 20%;
    height: 0;
    border-bottom: 1px solid rgba(160, 90, 110, 0.12);
  }

  /* Wood grain texture overlay on entire panel */
  .door__panel--active::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(
        175deg,
        transparent 0px,
        transparent 4px,
        rgba(0, 0, 0, 0.04) 4px,
        rgba(0, 0, 0, 0.04) 5px,
        transparent 5px,
        transparent 11px,
        rgba(160, 90, 110, 0.03) 11px,
        rgba(160, 90, 110, 0.03) 12px,
        transparent 12px,
        transparent 18px
      );
    pointer-events: none;
    z-index: 1;
  }

  /* ---- Base/threshold ---- */
  .door__base {
    width: 100%;
    height: 3%;
    background: linear-gradient(180deg, #141a1a, #0e1212);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }

  /* ---- Number plaque — brass/gold ---- */
  .door__number--active {
    position: absolute;
    top: 5%;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-pixel);
    font-size: clamp(0.45rem, 1.2vw, 0.6rem);
    color: #c8a0a8;
    pointer-events: none;
    z-index: 2;
    text-shadow:
      0 1px 1px rgba(0, 0, 0, 0.9),
      0 0 4px rgba(180, 100, 120, 0.3);
    background: rgba(40, 18, 22, 0.6);
    padding: 1px 4px;
    line-height: 1.4;
    border: 1px solid rgba(160, 90, 110, 0.2);
  }

  /* ---- Oriental ring-pull handle ---- */
  .door__handle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #252b2b, #1a1e1e 60%, #111414);
    box-shadow:
      0 0 0 2px #151a1a,
      0 0 0 3px rgba(255, 255, 255, 0.05),
      0 2px 4px rgba(0, 0, 0, 0.5);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Raised ring */
  .door__handle-ring {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid #2a3030;
    background: transparent;
    box-shadow:
      inset 0 -1px 0 rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 1px 2px rgba(0, 0, 0, 0.3);
    position: relative;
    top: 1px;
  }

  /* Highlight glint on ring */
  .door__handle-ring::after {
    content: '';
    position: absolute;
    top: 0;
    left: 2px;
    width: 3px;
    height: 2px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
  }

  /* ===== Inactive door — grey, flat ===== */
  .door--inactive {
    cursor: not-allowed;
  }

  .door__sprite {
    width: 60%;
    height: 75%;
    position: relative;
    image-rendering: pixelated;
  }

  .door__panel--inactive {
    width: 100%;
    height: 100%;
    border-radius: 2px;
    position: relative;
    background: #3a3a3a;
    box-shadow:
      inset 0 0 0 2px #444,
      inset 0 0 8px rgba(0, 0, 0, 0.5),
      0 0 0 3px #2a2a2a;
    filter: grayscale(1) brightness(0.5);
  }

  .door__knob--inactive {
    position: absolute;
    right: 12%;
    top: 50%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #555;
    transform: translateY(-50%);
  }

  /* Inactive number */
  .door__number {
    position: absolute;
    top: 18%;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-pixel);
    font-size: clamp(0.5rem, 1.5vw, 0.7rem);
    color: var(--color-text-muted);
    pointer-events: none;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
  }

  /* ===== Open animation ===== */
  .door__inner {
    position: relative;
    transform-style: preserve-3d;
  }

  /* Door edge — visible thickness during swing */
  .door__inner::after {
    content: '';
    position: absolute;
    top: 0;
    right: -8px;
    width: 8px;
    height: 100%;
    background: linear-gradient(90deg, #141a1a, #0e1212);
    transform: rotateY(90deg);
    transform-origin: left center;
    box-shadow: inset 0 0 4px rgba(0, 0, 0, 0.6);
    opacity: 0;
    transition: opacity 0.05s;
  }

  .door--opening .door__inner::after {
    opacity: 1;
  }

  .door--opening .door__inner {
    animation: doorSwing 600ms steps(8) forwards;
    transform-origin: left center;
  }

  @keyframes doorSwing {
    0% { transform: perspective(600px) rotateY(0deg); }
    100% { transform: perspective(600px) rotateY(-85deg); }
  }
</style>
